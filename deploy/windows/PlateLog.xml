<service>
  <id>PlateLog</id>
  <name>PlateLog</name>
  <description>PlateLog synthetic camera preview</description>
  <executable>%BASE%\.venv\Scripts\python.exe</executable>
  <arguments>-E -B -m platelog preview --host 0.0.0.0 --allowed-host * --port 8765 --timezone Australia/Sydney --data-dir "%ProgramData%\PlateLog\data" --manage-web-port</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <logpath>%ProgramData%\PlateLog\logs</logpath>
  <log mode="roll"/>
</service>
